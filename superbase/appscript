function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu("Overview Tools")
    .addItem("Setup All Dropdowns", "setupAllDropdowns")
    .addItem("Setup Overview Dropdowns", "setupOverviewDropdowns")
    .addItem("Setup Cockpit", "setupCockpit")
    .addItem("Refresh Divisions", "refreshDivisions")
    .addItem("Repair Overview Formats", "repairOverviewFormatsNow")
    .addItem("Fix Date Formats", "formatKnownDateColumns_")
    .addItem("Add Empty Columns to Overview", "addEmptyColumnsToOverview")
    .addToUi();
}

function onEdit(e) {
  try {
    if (!e || !e.range) return;

    const sheet = e.range.getSheet();

    if (sheet.getName() !== SHEETS.cockpit) return;
    if (e.range.getA1Notation() !== COCKPIT_COMPANY_CELL) return;

    setupCockpit();
  } catch (err) {}
}

function setupAllDropdowns() {
  normalizeSheetNames_();
  setupOverviewDropdowns();
  setupCockpit();
  cleanupCompaniesSheet_();
  formatKnownDateColumns_();
  addEmptyColumnsToOverview(); 

  SpreadsheetApp.getActiveSpreadsheet().toast(
    "Overview reordered, Divisions added, formats repaired, and dropdowns synced.",
    "Done",
    5
  );
}

function cleanupCompaniesSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const companies = ss.getSheetByName(SHEETS.companies);

  if (!companies) {
    return;
  }

  deleteColumnsByHeader_(companies, ["Register Court"]);
}

function refreshDivisions() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const overview = getSheet_(ss, SHEETS.overview);

  syncDivisionsColumn_(overview);
  applyOverviewColumnFormats_(overview);

  SpreadsheetApp.getActiveSpreadsheet().toast(
    "Divisions refreshed.",
    "Done",
    4
  );
}

function repairOverviewFormatsNow() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const overview = getSheet_(ss, SHEETS.overview);

  applyOverviewColumnFormats_(overview);

  SpreadsheetApp.getActiveSpreadsheet().toast(
    "Overview formats repaired.",
    "Done",
    5
  );
}

/****************************************************
OVERVIEW DROPDOWNS
****************************************************/

function setupOverviewDropdowns() {
  normalizeSheetNames_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const overview = getSheet_(ss, SHEETS.overview);
  const shareholders = getSheet_(ss, SHEETS.shareholders);
  const ubos = getSheet_(ss, SHEETS.ubos);

  overview
    .getRange(1, 1, overview.getMaxRows(), overview.getMaxColumns())
    .clearDataValidations();

  deleteDynamicColumns_(overview);
  deleteColumnsByHeader_(overview, [DIVISION_HEADER, "Division", "Register Court"]);
  deleteColumnsByHeader_(overview, [
    "Register Number",
    "Register Type",
    "No. of Management",
    "Number of Management",
  ]);
  deleteColumnsByHeader_(overview, [
    "Natural Person Management Count",
    "Legal Person Management Count",
    "Youngest Management Age",
    "Oldest Management Age",
    "Main Management Name",
    "Main Management Role",
    "Main Management Age",
  ]);

  clearStaleWzFilterHeader_(overview);

  reorderOverviewColumns_(overview);
  syncDivisionsColumn_(overview);
  resetDynamicColumnsBeforeFitScore_(overview);

  const ovH = getHeaderMap_(overview);
  const shH = getHeaderMap_(shareholders);
  const uboH = getHeaderMap_(ubos);

  const ovCompanyCol = findCol_(ovH, ALIASES.companyId, true);

  const managementSheet = getSheet_(ss, SHEETS.management);
  const mgmtH = getHeaderMap_(managementSheet);

  const mgmtMap = buildDropdownMap_(
    managementSheet,
    findCol_(mgmtH, ALIASES.companyId, true),
    findCol_(mgmtH, ALIASES.managementName, true)
  );

  const shMap = buildDropdownMap_(
    shareholders,
    findCol_(shH, ALIASES.companyId, true),
    findCol_(shH, ALIASES.shareholderName, true)
  );

  const uboMap = buildDropdownMap_(
    ubos,
    findCol_(uboH, ALIASES.companyId, true),
    findCol_(uboH, ALIASES.uboName, true)
  );

  const mgmtNameCol = findCol_(ovH, ["Management Name"], true);
  const shNameCol = findCol_(ovH, ["Shareholder Name"], true);
  const uboNameCol = findCol_(ovH, ["UBO Name"], true);

  const lastRow = overview.getLastRow();

  if (lastRow <= HEADER_ROW) return;

  const totalRows = lastRow - HEADER_ROW;

  const overviewData = overview
    .getRange(HEADER_ROW + 1, 1, totalRows, overview.getLastColumn())
    .getDisplayValues();

  const mgmtRules = [];
  const shRules = [];
  const uboRules = [];
  const mgmtDefaults = [];
  const shDefaults = [];
  const uboDefaults = [];

  for (let i = 0; i < totalRows; i++) {
    const rowNum = HEADER_ROW + 1 + i;
    const companyId = cleanId_(overviewData[i][ovCompanyCol - 1]);

    const mgmtOptions = mgmtMap[companyId] || [];
    const shOptions = shMap[companyId] || [];
    const uboOptions = uboMap[companyId] || [];

    mgmtRules.push([buildListValidation_(mgmtOptions)]);
    shRules.push([buildListValidation_(shOptions)]);
    uboRules.push([buildListValidation_(uboOptions)]);

    mgmtDefaults.push([mgmtOptions.length ? mgmtOptions[0] : ""]);
    shDefaults.push([shOptions.length ? shOptions[0] : ""]);
    uboDefaults.push([uboOptions.length ? uboOptions[0] : ""]);

    setOverviewFormulas_(overview, rowNum, ovH, shH, uboH, mgmtH);
  }

  const mgmtRange = overview.getRange(HEADER_ROW + 1, mgmtNameCol, totalRows, 1);
  const shRange = overview.getRange(HEADER_ROW + 1, shNameCol, totalRows, 1);
  const uboRange = overview.getRange(HEADER_ROW + 1, uboNameCol, totalRows, 1);

  mgmtRange.setValues(mgmtDefaults);
  shRange.setValues(shDefaults);
  uboRange.setValues(uboDefaults);

  mgmtRange.setDataValidations(mgmtRules);
  shRange.setDataValidations(shRules);
  uboRange.setDataValidations(uboRules);

  styleDynamicHeaders_(overview);
  styleOverviewHeader_(overview);
  applyOverviewColumnFormats_(overview);

  fillOverviewFormulaColumns_(overview, totalRows);
  fillMdOwnerLastNameCheckFormulas_(overview, totalRows, ovH, mgmtH, shH, uboH);
}

function _colLetter_(col) {
  let letter = "";
  while (col > 0) {
    const rem = (col - 1) % 26;
    letter = String.fromCharCode(65 + rem) + letter;
    col = Math.floor((col - 1) / 26);
  }
  return letter;
}

function fillOverviewFormulaColumns_(sheet, totalRows) {
  if (totalRows < 1) return;

  const h = getHeaderMap_(sheet);
  const firstDataRow = HEADER_ROW + 1;

  // --- Revenue column: NorthData revenue if present, else OpenRegister revenue ---
  const revenueCol = findCol_(h, ["Revenue"], false);
  const ndRevCol = findCol_(h, ALIASES.northdataRevenue, false);
  const orRevCol = findCol_(h, ALIASES.openregisterRevenue, false);

  if (revenueCol && ndRevCol && orRevCol) {
    const nd = _colLetter_(ndRevCol);
    const or = _colLetter_(orRevCol);
    const formulas = [];
    for (let i = 0; i < totalRows; i++) {
      const r = firstDataRow + i;
      formulas.push([`=IF(${nd}${r}<>"",${nd}${r},IF(${or}${r}<>"",${or}${r},""))`]);
    }
    sheet.getRange(firstDataRow, revenueCol, totalRows, 1).setFormulas(formulas);
  }

  // --- Net Income column: NorthData net income if present, else OpenRegister ---
  const netIncomeCol = findCol_(h, ["Net Income"], false);
  const ndNiCol = findCol_(h, ALIASES.northdataNetIncome, false);
  const orNiCol = findCol_(h, ALIASES.openregisterNetIncome, false);

  if (netIncomeCol && ndNiCol && orNiCol) {
    const nd = _colLetter_(ndNiCol);
    const or = _colLetter_(orNiCol);
    const formulas = [];
    for (let i = 0; i < totalRows; i++) {
      const r = firstDataRow + i;
      formulas.push([`=IF(${nd}${r}<>"",${nd}${r},IF(${or}${r}<>"",${or}${r},""))`]);
    }
    sheet.getRange(firstDataRow, netIncomeCol, totalRows, 1).setFormulas(formulas);
  }

  // --- Unique WZ Code column: Yes/No if the code typed in THIS column's own
  //     header cell (row 1) appears in the row's NorthData or OpenRegister WZ
  //     code column. The header cell doubles as the filter input - there is no
  //     separate filter column anymore. ---
  const uniqueCol = findCol_(h, ["Unique WZ Code"], false);
  const ndWzCol = findCol_(h, ALIASES.wzCode, false);
  const orWzCol = findCol_(h, ALIASES.openregisterWz, false);

  if (uniqueCol && ndWzCol && orWzCol) {
    const nd = _colLetter_(ndWzCol);
    const or = _colLetter_(orWzCol);
    // The filter input is this column's own header cell (row 1). Typing a WZ
    // code there drives every row's Yes/No; leaving it blank blanks the column.
    const filterCell = `$${_colLetter_(uniqueCol)}$${HEADER_ROW}`;

    const formulas = [];
    for (let i = 0; i < totalRows; i++) {
      const r = firstDataRow + i;
      // Exact whole-token match, not substring: the typed code must appear
      // bounded by start/end-of-cell, a comma, or whitespace on both sides -
      // so "0.42" does NOT match inside "20.42", but "10.42" matches
      // "10.42 Some description" or "10.42" inside a comma list.
      const combined = `${nd}${r}&","&${or}${r}`;
      const escapedCode = `SUBSTITUTE(${filterCell},".","\\.")`;
      const pattern = `"(^|[,\\s])"&${escapedCode}&"([,\\s]|$)"`;
      formulas.push([
        `=IF(${filterCell}="","",IF(REGEXMATCH(${combined},${pattern}),"Yes","No"))`,
      ]);
    }
    sheet.getRange(firstDataRow, uniqueCol, totalRows, 1).setFormulas(formulas);

    // Blank the header cell so it reads as an empty input box. The row formulas
    // above point at it, so a WZ code typed here immediately drives Yes/No.
    sheet.getRange(HEADER_ROW, uniqueCol).setNumberFormat("@").setValue("");
  }
}

// Clears a stale value left in the WZ filter column's header cell (row 1) from
// a previous run before the sheet is reordered. Because that header is
// intentionally empty (it's the filter input), a WZ code the user typed there
// would otherwise survive a rebuild as an orphaned column. The filter column is
// the one immediately after "OpenRegister WZ Code"; we only clear it when its
// header isn't a genuine, known Overview column.
function clearStaleWzFilterHeader_(sheet) {
  const h = getHeaderMap_(sheet);
  const orWz = findCol_(h, ALIASES.openregisterWz, false);

  if (!orWz || orWz + 1 > sheet.getLastColumn()) return;

  const nextHeader = cleanText_(
    sheet.getRange(HEADER_ROW, orWz + 1).getDisplayValue()
  );

  if (!nextHeader) return;
  if (norm_(nextHeader) === norm_("Unique WZ Code")) return;

  const isKnown = OVERVIEW_COLUMN_SPECS.some(
    spec => spec.header && norm_(spec.header) === norm_(nextHeader)
  );

  if (!isKnown) {
    sheet.getRange(HEADER_ROW, orWz + 1).setValue("");
  }
}

function reorderOverviewColumns_(sheet) {
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow < HEADER_ROW || lastCol < 1) return;

  const valueRange = sheet.getRange(1, 1, lastRow, lastCol);
  const values = valueRange.getValues();
  const formulas = valueRange.getFormulas();

  const headers = sheet
    .getRange(HEADER_ROW, 1, 1, lastCol)
    .getDisplayValues()[0];

  const sourceMap = {};

  headers.forEach((header, index) => {
    const key = norm_(header);

    if (key && sourceMap[key] === undefined) {
      sourceMap[key] = index;
    }
  });

  const usedIndexes = {};
  const selectedColumns = [];

  OVERVIEW_COLUMN_SPECS.forEach(spec => {
    const sourceIndex = findSourceIndexForAliases_(sourceMap, spec.aliases);

    if (sourceIndex === null) {
      if (spec.forceCreate) {
        selectedColumns.push({
          sourceIndex: null,
          header: spec.header,
        });
      }

      return;
    }

    if (usedIndexes[sourceIndex]) return;

    usedIndexes[sourceIndex] = true;

    selectedColumns.push({
      sourceIndex,
      header: spec.header,
    });
  });

  if (selectedColumns.length === 0) return;

  const output = [];

  for (let row = 0; row < lastRow; row++) {
    const outRow = [];

    selectedColumns.forEach(col => {
      if (row === HEADER_ROW - 1) {
        outRow.push(col.header);
      } else if (col.sourceIndex === null) {
        outRow.push("");
      } else {
        outRow.push(formulas[row][col.sourceIndex] || values[row][col.sourceIndex]);
      }
    });

    output.push(outRow);
  }

  const neededCols = selectedColumns.length;

  sheet
    .getRange(1, 1, sheet.getMaxRows(), sheet.getMaxColumns())
    .clearContent()
    .clearDataValidations()
    .clearFormat();

  if (sheet.getMaxColumns() < neededCols) {
    sheet.insertColumnsAfter(
      sheet.getMaxColumns(),
      neededCols - sheet.getMaxColumns()
    );
  }

  if (sheet.getMaxColumns() > neededCols) {
    sheet.deleteColumns(
      neededCols + 1,
      sheet.getMaxColumns() - neededCols
    );
  }

  sheet
    .getRange(1, 1, output.length, neededCols)
    .setValues(output);

  styleOverviewHeader_(sheet);
}

function findSourceIndexForAliases_(sourceMap, aliases) {
  for (let i = 0; i < aliases.length; i++) {
    const key = norm_(aliases[i]);

    if (sourceMap[key] !== undefined) {
      return sourceMap[key];
    }
  }

  return null;
}

