function fillMdOwnerLastNameCheckFormulas_(overview, totalRows, ovH, mgmtH, shH, uboH) {
  const checkCol = findCol_(ovH, [MD_OWNER_LAST_NAME_CHECK_HEADER], true);
  const ageCheckCol = findCol_(ovH, [MD_OWNER_AGE_CHECK_HEADER], true);
  const companyCol = findCol_(ovH, ALIASES.companyId, true);

  const mgmtCompanyL = colToLetter_(findCol_(mgmtH, ALIASES.companyId, true));
  const mgmtNameL = colToLetter_(findCol_(mgmtH, ALIASES.managementName, true));
  const mgmtRoleL = colToLetter_(findCol_(mgmtH, ALIASES.managementRole, true));
  const mgmtAgeL = colToLetter_(findCol_(mgmtH, ALIASES.managementAge, true));

  const shCompanyL = colToLetter_(findCol_(shH, ALIASES.companyId, true));
  const shNameL = colToLetter_(findCol_(shH, ALIASES.shareholderName, true));

  const uboCompanyL = colToLetter_(findCol_(uboH, ALIASES.companyId, true));
  const uboNameL = colToLetter_(findCol_(uboH, ALIASES.uboName, true));

  if (totalRows < 1) return;

  const companyColL = colToLetter_(companyCol);
  const formulas = [];
  const ageCheckFormulas = [];

  for (let i = 0; i < totalRows; i++) {
    const row = HEADER_ROW + 1 + i;
    const companyCell = `${companyColL}${row}`;
    const lastNameCheckCell = overview.getRange(row, checkCol).getA1Notation();

    const formula = `=LET(
      company,UPPER(TRIM(${companyCell})),
      MDs,IFERROR(FILTER(TRIM('${SHEETS.management}'!${mgmtNameL}:${mgmtNameL}),UPPER(TRIM('${SHEETS.management}'!${mgmtCompanyL}:${mgmtCompanyL}))=company,UPPER(TRIM('${SHEETS.management}'!${mgmtRoleL}:${mgmtRoleL}))="DIRECTOR"),""),
      Shareholders,IFERROR(FILTER(TRIM('${SHEETS.shareholders}'!${shNameL}:${shNameL}),UPPER(TRIM('${SHEETS.shareholders}'!${shCompanyL}:${shCompanyL}))=company),""),
      UBOs,IFERROR(FILTER(TRIM('${SHEETS.ubos}'!${uboNameL}:${uboNameL}),UPPER(TRIM('${SHEETS.ubos}'!${uboCompanyL}:${uboCompanyL}))=company),""),
      OWNERS,TOCOL({Shareholders;UBOs},1),
      ValidMDs,IFERROR(FILTER(MDs,MDs<>""),""),
      ValidOwners,IFERROR(FILTER(OWNERS,OWNERS<>""),""),
      IF(
        OR(COUNTA(ValidMDs)=0,COUNTA(ValidOwners)=0),
        "No",
        IF(
          SUM(
            MAP(
              ValidMDs,
              LAMBDA(md,
                SUM(
                  MAP(
                    ValidOwners,
                    LAMBDA(owner,
                      IF(
                        AND(
                          LOWER(TRIM(owner))<>LOWER(TRIM(md)),
                          LOWER(REGEXEXTRACT(TRIM(owner),"\\S+$"))=LOWER(REGEXEXTRACT(TRIM(md),"\\S+$"))
                        ),
                        1,
                        0
                      )
                    )
                  )
                )
              )
            )
          )>0,
          "Yes",
          "No"
        )
      )
    )`.replace(/\n\s+/g, " ");

    formulas.push([formula]);

    const ageCheckFormula = `=LET(
      company,UPPER(TRIM(${companyCell})),
      LastNameCheck,${lastNameCheckCell},
      MDs,IFERROR(FILTER(TRIM('${SHEETS.management}'!${mgmtNameL}:${mgmtNameL}),UPPER(TRIM('${SHEETS.management}'!${mgmtCompanyL}:${mgmtCompanyL}))=company,UPPER(TRIM('${SHEETS.management}'!${mgmtRoleL}:${mgmtRoleL}))="DIRECTOR",TRIM('${SHEETS.management}'!${mgmtNameL}:${mgmtNameL})<>""),""),
      MDAges,IFERROR(FILTER('${SHEETS.management}'!${mgmtAgeL}:${mgmtAgeL},UPPER(TRIM('${SHEETS.management}'!${mgmtCompanyL}:${mgmtCompanyL}))=company,UPPER(TRIM('${SHEETS.management}'!${mgmtRoleL}:${mgmtRoleL}))="DIRECTOR",TRIM('${SHEETS.management}'!${mgmtNameL}:${mgmtNameL})<>""),""),
      Shareholders,IFERROR(FILTER(TRIM('${SHEETS.shareholders}'!${shNameL}:${shNameL}),UPPER(TRIM('${SHEETS.shareholders}'!${shCompanyL}:${shCompanyL}))=company),""),
      UBOs,IFERROR(FILTER(TRIM('${SHEETS.ubos}'!${uboNameL}:${uboNameL}),UPPER(TRIM('${SHEETS.ubos}'!${uboCompanyL}:${uboCompanyL}))=company),""),
      OWNERS,TOCOL({Shareholders;UBOs},1),
      ValidOwners,IFERROR(FILTER(OWNERS,OWNERS<>""),""),
      IF(
        LastNameCheck<>"Yes",
        "No",
        IF(
          SUM(
            MAP(
              SEQUENCE(ROWS(MDs)),
              LAMBDA(i,
                LET(
                  md,INDEX(MDs,i),
                  mdAge,IFERROR(VALUE(INDEX(MDAges,i)),999999),
                  IF(
                    AND(
                      mdAge<=50,
                      SUM(
                        MAP(
                          ValidOwners,
                          LAMBDA(owner,
                            IF(
                              AND(
                                LOWER(TRIM(owner))<>LOWER(TRIM(md)),
                                LOWER(REGEXEXTRACT(TRIM(owner),"\\S+$"))=LOWER(REGEXEXTRACT(TRIM(md),"\\S+$"))
                              ),
                              1,
                              0
                            )
                          )
                        )
                      )>0
                    ),
                    1,
                    0
                  )
                )
              )
            )
          )>0,
          "Yes",
          "No"
        )
      )
    )`.replace(/\n\s+/g, " ");

    ageCheckFormulas.push([ageCheckFormula]);
  }

  overview.getRange(HEADER_ROW + 1, checkCol, totalRows, 1).setFormulas(formulas);
  overview.getRange(HEADER_ROW + 1, ageCheckCol, totalRows, 1).setFormulas(ageCheckFormulas);
}

