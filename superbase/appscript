    if (integerColumns.indexOf(header) !== -1) {
      bodyRange.setNumberFormat("0");
    }

    if (decimalColumns.indexOf(header) !== -1) {
      bodyRange.setNumberFormat("#,##0.##");
    }
  });
}

function applyOverviewColumnFormats_(sheet) {
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow <= HEADER_ROW || lastCol < 1) return;

  const headers = sheet
    .getRange(HEADER_ROW, 1, 1, lastCol)
    .getDisplayValues()[0];

  const bodyRows = Math.max(lastRow - HEADER_ROW, 1);

  const integerHeaders = new Set([
    "Founding Year",
    "Northdata Employees",
    "Openregister Employees",
    "Management Age",
    "No. of Management",
    "Shareholder Age",
    "UBO Age",
    "No. of Shareholders",
    "No. of Natural Shareholders",
    "No. of Legal Shareholders",
    "Youngest Shareholders Age",
    "Oldest Shareholders Age",
    "No. of UBOs",
    "No. of Natural UBOs",
    "No. of Legal UBOs",
    "Oldest UBO Age",
    "Youngest UBO Age",
    "Fit Score",
  ]);

  const moneyHeaders = new Set([
    "Northdata Revenue €",
    "OpenRegister Revenue €",
    "Northdata Balance Sheet Total €",
    "Openregister Balance Sheet Total €",
    "Northdata Net Income €",
    "Openregister Net Income €",
    "Northdata Equity €",
    "Openregister Equity €",
    "Northdata Cash €",
    "Openregister Cash €",
    "Northdata Liabilities €",
    "Openregister Liabilities €",
    "Net Income",
  ]);

  const percentHeaders = new Set([
    "Shareholder Ownership %",
    "UBO %",
  ]);

  const dateHeaders = new Set([
    "Northdata Financials Date",
    "Openregister Financials Date",
  ]);

  const booleanHeaders = new Set([
    "Active",
  ]);

  for (let col = 1; col <= lastCol; col++) {
    const header = cleanText_(headers[col - 1]);
    const range = sheet.getRange(HEADER_ROW + 1, col, bodyRows, 1);

    range.clearFormat();

    if (moneyHeaders.has(header)) {
      range.setNumberFormat("#,##0.00");
    } else if (integerHeaders.has(header)) {
      range.setNumberFormat("0");
    } else if (percentHeaders.has(header)) {
      range.setNumberFormat("0.00");
    } else if (dateHeaders.has(header)) {
      range.setNumberFormat("yyyy-mm-dd");
    } else if (booleanHeaders.has(header)) {
      range.setNumberFormat("@");
    } else {
      range.setNumberFormat("@");
    }

    range.setWrap(true);
    range.setVerticalAlignment("top");
  }

  styleOverviewHeader_(sheet);
}

